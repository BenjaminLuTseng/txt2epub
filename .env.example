# Copy to .env for local use, or set these as Fly secrets in production:
#   fly secrets set ANTHROPIC_API_KEY=... APP_PASSWORD=... SECRET_KEY=...
# .env is gitignored. Never commit real values.

# Enables the Claude features. Without it the app runs on heuristics only.
ANTHROPIC_API_KEY=

# Required in the cloud. Leave empty for localhost to skip the login screen.
# Anyone with this password can spend the API key above.
APP_PASSWORD=

# Signs the session cookie. Generate with: python3 -c "import secrets;print(secrets.token_hex(32))"
# If unset, a random key is generated at boot and every restart logs you out.
SECRET_KEY=

# Optional tuning
# TXT2EPUB_MODEL=claude-opus-5
# MAX_UPLOAD_MB=32
# SESSION_HOURS=12
# JOB_TTL_SECONDS=21600
# MAX_JOBS=12
